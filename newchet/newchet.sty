% newchet.sty
%
%   \documentclass[11pt,a4paper]{article}
%   \usepackage{newchet}
%   \addbibresource{bibliography.bib}
%   \preprint{...}  \title{...}  \author{...\email{...}}  \affiliation{...}  \abstract{...}
%   \begin{document} \maketitle ... \printbibliography \end{document}
%
% The title page imitates chet.sty: preprint number top right, a large title, authors,
% affiliations in italics, the abstract, and the date (month and year) bottom left.
% \preprint, \affiliation and \abstract{...} go in the preamble.  \date{...} overrides the
% date.  Emails are footnotes: \email{...} side by side, \emailV{...} one below the other,
% \emails{...} all in one unmarked footnote.  Use $\titlemath{...}$ for math in the title.
%
% Install into the personal tree so that it works from any directory:
%   ~/Library/texmf/tex/latex/newchet/newchet.sty
% With stix2, newchet also uses two virtual fonts, which bring subscripts closer to italic
% letters.  They go into the same tree, or into the document folder:
%   ~/Library/texmf/fonts/tfm/newchet/newchet-stix2-mathit{,-bold}.tfm
%   ~/Library/texmf/fonts/vf/newchet/newchet-stix2-mathit{,-bold}.vf
% make install-newchet in the chet repository installs all five files (into ~/texmf on Linux).
%
% Options
%   nobib        do not load biblatex (use with revtex, bst files, or no bibliography)
%   nogeometry   do not load geometry (the class or another package sets the margins)
%   nohyperref   do not load hyperref
%   notoc        do not load tocloft or reformat the table of contents
%   notitlesec   do not load titlesec or reformat the section headings
%   notitlepage  keep the class's own \maketitle and abstract environment
%   notheorems   do not define theorem, proposition, conjecture
%   newtx        set text and math in newtxtext and newtxmath (Times) instead of
%                Computer Modern; the title is then set in newtxtext too.  Word and line
%                spacing are widened as with stix2.
%   stix2        set text and math in STIX Two instead of Computer Modern; the title
%                is then set in STIX Two too.  Typewriter text is set in newtxtt, since
%                STIX Two has none.  \mathbb is the blackboard bold of DSSerif, loaded through
%                \usepackage[bb=dsserif,bbscaled=1.025]{mathalpha}, unless the document loads
%                mathalpha itself.  Word and line spacing are widened as with Computer
%                Modern, but lines are spread by 1.15 instead of 1.25.  Of newtx and
%                stix2, the last one given wins.
%   newtxgreek   take the math Greek letters from newtxmath, e.g. with stix2; newtx has them already
%   nosubscriptkerns  with stix2, keep the subscript placement of the stix2 package instead of
%                that of newchet's virtual fonts (see the font setup below)
%   fontsize=11.5pt  body size for article, report or book, which only offer 10pt, 11pt and
%                12pt; the 11pt sizes and spacings are scaled to match
% Any other option is handed to biblatex, e.g. \usepackage[backend=bibtex]{newchet}.
% The margins can still be changed afterwards with \geometry{margin=3cm}.

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{newchet}[2026/10/26 v1.0 personal article style with chetref-like bibliography]

\newif\ifnewchet@bib        \newchet@bibtrue
\newif\ifnewchet@geometry   \newchet@geometrytrue
\newif\ifnewchet@hyperref   \newchet@hyperreftrue
\newif\ifnewchet@toc        \newchet@toctrue
\newif\ifnewchet@titlesec   \newchet@titlesectrue
\newif\ifnewchet@titlepage  \newchet@titlepagetrue
\newif\ifnewchet@theorems   \newchet@theoremstrue
\newif\ifnewchet@ntxgreek   \newchet@ntxgreekfalse
\newif\ifnewchet@subkerns   \newchet@subkernstrue
\def\newchet@fonts{cm}
\let\newchet@size\@empty

\DeclareOption{nobib}{\newchet@bibfalse}
\DeclareOption{nogeometry}{\newchet@geometryfalse}
\DeclareOption{nohyperref}{\newchet@hyperreffalse}
\DeclareOption{notoc}{\newchet@tocfalse}
\DeclareOption{notitlesec}{\newchet@titlesecfalse}
\DeclareOption{notitlepage}{\newchet@titlepagefalse}
\DeclareOption{notheorems}{\newchet@theoremsfalse}
\DeclareOption{newtx}{\def\newchet@fonts{newtx}}
\DeclareOption{stix2}{\def\newchet@fonts{stix2}}
\DeclareOption{newtxgreek}{\newchet@ntxgreektrue}
\DeclareOption{nosubscriptkerns}{\newchet@subkernsfalse}
% fontsize=<size> is caught here; every other unknown option goes to biblatex
\DeclareOption*{\expandafter\newchet@option\CurrentOption=\@nil}
\def\newchet@option#1=#2\@nil{%
  \def\newchet@tempa{#1}\def\newchet@tempb{fontsize}%
  \ifx\newchet@tempa\newchet@tempb
    \newchet@setsize#2\@nil
  \else
    \PassOptionsToPackage{\CurrentOption}{biblatex}%
  \fi}
\def\newchet@setsize#1=\@nil{\edef\newchet@size{\number\dimexpr#1\relax}}
\ProcessOptions*\relax

% tocloft cannot patch the table of contents of the AMS classes, and memoir has
% tocloft's features built in and refuses to load it, so drop that part
% of the style there rather than let the document fail
\ifnewchet@toc
  \@ifclassloaded{amsart}{\newchet@tocfalse}{}%
  \@ifclassloaded{amsbook}{\newchet@tocfalse}{}%
  \@ifclassloaded{amsproc}{\newchet@tocfalse}{}%
  \@ifclassloaded{memoir}{\newchet@tocfalse}{}%
  \ifnewchet@toc\else
    \PackageWarningNoLine{newchet}{tocloft is incompatible with this class,%
      \MessageBreak so the table of contents is left as the class sets it}%
  \fi
\fi

% titlesec redefines the sectioning commands and breaks or fights the classes that
% have their own heading machinery, so leave the headings to the class there
\ifnewchet@titlesec
  \@for\newchet@cls:=amsart,amsbook,amsproc,revtex4,revtex4-1,revtex4-2,memoir,%
      scrartcl,scrreprt,scrbook\do{%
    \@ifclassloaded{\newchet@cls}{\newchet@titlesecfalse}{}}%
  \ifnewchet@titlesec\else
    \PackageWarningNoLine{newchet}{titlesec is incompatible with this class,%
      \MessageBreak so the section headings are left as the class sets them}%
  \fi
\fi

% The AMS, revtex and memoir classes have their own title machinery (\address,
% \affiliation, \thanks handling), so leave their title page alone
\ifnewchet@titlepage
  \@for\newchet@cls:=amsart,amsbook,amsproc,revtex4,revtex4-1,revtex4-2,memoir\do{%
    \@ifclassloaded{\newchet@cls}{\newchet@titlepagefalse}{}}%
  \ifnewchet@titlepage\else
    \PackageWarningNoLine{newchet}{this class sets its own title page,%
      \MessageBreak so \string\maketitle\space is left as the class defines it}%
  \fi
\fi

% ----------------------------------------------------------------------------
% Page, fonts, general packages
% ----------------------------------------------------------------------------
\ifnewchet@geometry
  \RequirePackage[margin=2.4cm]{geometry}
\fi
% fix-cm makes Computer Modern available at every size, so the title and the math in it
% can follow the body size (see \newchet@titlesize).  It is loaded with every font option,
% since STIX Two has no sans serif and the caption labels are then set in cmss.
\RequirePackage{fix-cm}
% fix-cm warns when it replaces bold typewriter by medium, which t1cmtt.fd does silently
\DeclareFontShape{T1}{cmtt}{bx}{n}{<->ssub*cmtt/m/n}{}
\DeclareFontShape{T1}{cmtt}{bx}{it}{<->ssub*cmtt/m/it}{}
\def\newchet@tempa{cm}
\RequirePackage[T1]{fontenc}
% newtxmath and stix2 provide the amssymb symbols themselves and want amsmath and amsthm
% loaded first
\ifx\newchet@fonts\newchet@tempa
  \RequirePackage{amsmath,amssymb,amsthm}
\else
  \RequirePackage{amsmath,amsthm}
  \def\newchet@tempa{newtx}
  \ifx\newchet@fonts\newchet@tempa
    \RequirePackage{newtxtext}
    \RequirePackage{newtxmath}
  \else
    \RequirePackage{stix2}
    % STIX Two has no typewriter, and the x-height of cmtt is 9% below that of STIX Two
    % Text.  newtxtt has a bold, and scaled=1.02 matches the x-heights.
    \RequirePackage[scaled=1.02]{newtxtt}
    % STIX Two Math puts the numerator and denominator of a text-style fraction 0.585em
    % above and below the baseline.  Their gaps to the bar are then about 0.3em, more than
    % twice those of Computer Modern, and inline fractions run into the lines around them.
    % Reset both shifts at every size, for gaps of 0.08em to the bar.  TeX still keeps
    % each gap at least one rule thickness for taller numerators and denominators.
    \def\newchet@stixfrac#1{%
      \fontdimen9#1=0.372\fontdimen6#1%
      \fontdimen12#1=0.347\fontdimen6#1}
    \every@math@size\expandafter{\the\every@math@size
      \newchet@stixfrac{\textfont\tw@}%
      \newchet@stixfrac{\scriptfont\tw@}%
      \newchet@stixfrac{\scriptscriptfont\tw@}}
    % stix2 declares the script sizes only for 10pt text, as 75% and 60% of it.  Use the
    % same ratios at the other sizes, instead of LaTeX's 70% and 50%.  LaTeX also declares
    % fixed sizes, such as 8pt and 6pt at 11pt and 12pt, so drop those from 9pt up.  Below
    % 9pt, keep them, since 60% would fall under their 5pt minimum.
    \def\defaultscriptratio{.75}
    \def\defaultscriptscriptratio{.6}
    \@for\newchet@tempa:=9,10.95,12,14.4,17.28,20.74,24.88\do{%
      \expandafter\let\csname S@\newchet@tempa\endcsname\relax}
    % \mathbb is the blackboard bold of DSSerif.  It has a bold weight, so \mathbb is bold in
    % bold text, where \bfseries also switches to \boldmath (below); the AMS blackboard bold
    % (msbm) and that of STIX Two have none.  The capitals of DSSerif are 1.5% shorter than
    % the upright ones of STIX Two, and bbscaled=1.025 leaves them 0.9% taller.  mathalpha is
    % loaded at the end of the preamble, and only if the document has not loaded it, so a
    % document can still choose its own options, e.g. \usepackage[bb=ams]{mathalpha} for the
    % AMS blackboard bold.
    \AddToHook{begindocument/before}{%
      \@ifpackageloaded{mathalpha}{}{\RequirePackage[bb=dsserif,bbscaled=1.025]{mathalpha}}}
    % TeX attaches a subscript at the width of a letter.  It attaches a superscript at the
    % width plus the italic correction.  The stix2 metrics give most italic capitals a width
    % that includes nearly all of their overhang (V: 0.696em, italic correction 0.045em).
    % Subscripts then sit beyond the top-right corner of V, W, Y, T, F, P and similar
    % letters, far from their foot.  The virtual fonts newchet-stix2-mathit and
    % newchet-stix2-mathit-bold draw the same glyphs at the same places.  In them, 22 regular
    % and 15 bold Latin letters are narrower and have a larger italic correction, by the
    % same amount.  So only the subscripts move.  Superscripts, primes, accents and letters
    % side by side keep their places.  Limits are the exception.  TeX offsets them by half
    % the italic correction, so the label of \stackrel{*}{T} and the limits of
    % \mathop{T}\limits move by half as much.  \overset and \underset are not affected.  The
    % amounts come from the math italic of SticksToo (V: 0.11em), which newtxmath uses with
    % its option stickstoo.  newchet-subscripts.py makes the fonts.
    % pdfTeX loads fonts through its font paths, not through TEXINPUTS.  So \IfFileExists
    % alone cannot tell whether they will load.  kpsewhich searches the font paths, and TeX
    % Live's restricted shell escape allows it.  The calls give -format.  Without it,
    % kpsewhich looks up a name ending in .vf on OVFFONTS, the path of Omega's virtual
    % fonts, and not on VFFONTS, which pdfTeX uses and make newchet-subscripts-test sets.
    % If kpsewhich cannot run, only the document folder is checked, since it is on every
    % font path.  All four files must be found, or the fonts are not used.
    \ifnewchet@subkerns
      \def\newchet@subfonts{newchet-stix2-mathit.tfm,newchet-stix2-mathit.vf,%
        newchet-stix2-mathit-bold.tfm,newchet-stix2-mathit-bold.vf}
      \def\newchet@found{0}
      % One line of output for each file kpsewhich finds; \readline takes the paths verbatim
      \def\newchet@countlines{%
        \readline\@inputcheck to\newchet@tempa
        \ifx\newchet@tempa\@empty\else\xdef\newchet@found{\the\numexpr\newchet@found+1}\fi
        \ifeof\@inputcheck\else\expandafter\newchet@countlines\fi}
      \def\newchet@kpsewhich#1{%
        \begingroup
          \endlinechar\m@ne
          \openin\@inputcheck=|"kpsewhich -format=#1 newchet-stix2-mathit newchet-stix2-mathit-bold"
          \ifeof\@inputcheck\else\newchet@countlines\fi
          \closein\@inputcheck
        \endgroup}
      \newchet@kpsewhich{tfm}%
      \newchet@kpsewhich{vf}%
      \ifnum\newchet@found<4
        \def\newchet@found{0}
        \@for\newchet@tempa:=\newchet@subfonts\do{%
          \IfFileExists{./\newchet@tempa}{\xdef\newchet@found{\the\numexpr\newchet@found+1}}{}}%
      \fi
      \ifnum\newchet@found=4
        \input{ls1stix2.fd}%
        \DeclareFontShape{LS1}{stix2}{m}{it}{<-> newchet-stix2-mathit}{}%
        \DeclareFontShape{LS1}{stix2}{b}{it}{<-> newchet-stix2-mathit-bold}{}%
      \else
        \PackageWarningNoLine{newchet}{the virtual fonts newchet-stix2-mathit(-bold)%
          \MessageBreak were not found, so subscripts keep the placement of%
          \MessageBreak the stix2 package.  Install the fonts, or use the%
          \MessageBreak option nosubscriptkerns.  If kpsewhich cannot run,%
          \MessageBreak newchet only looks in the document folder}%
      \fi
    \fi
  \fi
\fi
% newtxgreek: the math Greek of newtxmath over STIX Two or Computer Modern.  Lowercase
% italic comes from ntxmi and uppercase upright from ntxmia, at newtxmath's slots.  The
% fonts get their own family names because the newtx .fd files need newtxmath's switches.
\def\newchet@tempa{newtx}
\ifnewchet@ntxgreek\ifx\newchet@fonts\newchet@tempa\else
  \DeclareFontFamily{OML}{newchetntxmi}{\skewchar\font=127 }
  \DeclareFontShape{OML}{newchetntxmi}{m}{it}{<-6.3> ntxmi5 <6.3-8.6> ntxmi7 <8.6-> ntxmi}{}
  \DeclareFontShape{OML}{newchetntxmi}{b}{it}{<-6.3> ntxbmi5 <6.3-8.6> ntxbmi7 <8.6-> ntxbmi}{}
  \DeclareFontFamily{U}{newchetntxmia}{\skewchar\font=127 }
  \DeclareFontShape{U}{newchetntxmia}{m}{it}{<-> ntxmia}{}
  \DeclareFontShape{U}{newchetntxmia}{b}{it}{<-> ntxbmia}{}
  \DeclareSymbolFont{newchetgreek}{OML}{newchetntxmi}{m}{it}
  \SetSymbolFont{newchetgreek}{bold}{OML}{newchetntxmi}{b}{it}
  \DeclareSymbolFont{newchetGreek}{U}{newchetntxmia}{m}{it}
  \SetSymbolFont{newchetGreek}{bold}{U}{newchetntxmia}{b}{it}
  \@tempcnta=0
  \@for\newchet@tempa:=Gamma,Delta,Theta,Lambda,Xi,Pi,Sigma,Upsilon,Phi,Psi,Omega\do{%
    \expandafter\DeclareMathSymbol\csname\newchet@tempa\endcsname{\mathalpha}{newchetGreek}{\@tempcnta}%
    \advance\@tempcnta\@ne}
  \@for\newchet@tempa:=alpha,beta,gamma,delta,epsilon,zeta,eta,theta,iota,kappa,lambda,mu,nu,xi,pi,rho,sigma,tau,upsilon,phi,chi,psi,omega,varepsilon,vartheta,varpi,varrho,varsigma,varphi\do{%
    \expandafter\DeclareMathSymbol\csname\newchet@tempa\endcsname{\mathord}{newchetgreek}{\@tempcnta}%
    \advance\@tempcnta\@ne}
  \DeclareMathSymbol{\varkappa}{\mathord}{newchetgreek}{129}
\fi\fi
% Script sizes that LaTeX calculates, for sizes it does not declare (fontsize=, the
% title), get the 5pt minimum of its declared ones, but never exceed the text size.
% This is the kernel's \calculate@math@sizes with the four \ifdim lines added.
\def\calculate@math@sizes{%
  \@font@info{Calculating\space math\space sizes\space for\space size\space <\f@size>}%
  \dimen@\f@size\p@
  \@tempdimb\defaultscriptratio\dimen@
  \dimen@\defaultscriptscriptratio\dimen@
  \ifdim\@tempdimb<5\p@ \@tempdimb5\p@ \fi
  \ifdim\dimen@<5\p@ \dimen@5\p@ \fi
  \ifdim\@tempdimb>\f@size\p@ \@tempdimb\f@size\p@ \fi
  \ifdim\dimen@>\f@size\p@ \dimen@\f@size\p@ \fi
  \expandafter\xdef\csname S@\f@size\endcsname{%
    \gdef\noexpand\tf@size{\f@size}%
    \gdef\noexpand\sf@size{\strip@pt\@tempdimb}%
    \gdef\noexpand\ssf@size{\strip@pt\dimen@}%
    \noexpand\math@fontstrue}}
% fontsize=<size>: the size commands and spacings of size11.clo, scaled by <size>/10.95pt,
% so that \normalsize is exactly <size> and everything keeps its 11pt proportions.  KOMA has
% its own fontsize option, and the other classes have their own size files.
\ifx\newchet@size\@empty\else
  \def\newchet@tempb{f}%
  \@for\newchet@cls:=article,report,book\do{\@ifclassloaded{\newchet@cls}{\def\newchet@tempb{t}}{}}%
  \if t\newchet@tempb
    % \newchet@sc{x} is x pt scaled, without the unit; \newchet@sk{x}{y}{z} is the scaled
    % glue x plus y minus z
    \def\newchet@sc#1{\strip@pt\dimexpr#1\p@*\newchet@size/\number\dimexpr10.95\p@\relax\relax}
    \def\newchet@sk#1#2#3{\newchet@sc{#1}\p@\@plus\newchet@sc{#2}\p@\@minus\newchet@sc{#3}\p@\relax}
    % \newchet@defsize\cmd{size}{baselineskip}{extra} defines \cmd with the values expanded
    \def\newchet@defsize#1#2#3#4{%
      \begingroup\edef\newchet@tempa{\endgroup
        \noexpand\DeclareRobustCommand\noexpand#1{%
          \noexpand\@setfontsize\noexpand#1{\newchet@sc{#2}}{\newchet@sc{#3}}#4}}%
      \newchet@tempa}
    \def\newchet@listi#1#2#3#4#5#6{%
      \def\noexpand\@listi{\leftmargin\leftmargini
        \topsep\newchet@sk{#1}{#2}{#3}\parsep\newchet@sk{#4}{#5}{#6}\itemsep\parsep}}
    \newchet@defsize\normalsize{10.95}{13.6}{%
      \abovedisplayskip\newchet@sk{11}{3}{6}\abovedisplayshortskip\newchet@sk{0}{3}{0}%
      \belowdisplayshortskip\newchet@sk{6.5}{3.5}{3}\belowdisplayskip\abovedisplayskip
      \let\noexpand\@listi\noexpand\@listI}
    \newchet@defsize\small{10}{12}{%
      \abovedisplayskip\newchet@sk{10}{2}{5}\abovedisplayshortskip\newchet@sk{0}{3}{0}%
      \belowdisplayshortskip\newchet@sk{6}{3}{3}\belowdisplayskip\abovedisplayskip
      \newchet@listi{6}{2}{2}{3}{2}{1}}
    \newchet@defsize\footnotesize{9}{11}{%
      \abovedisplayskip\newchet@sk{8}{2}{4}\abovedisplayshortskip\newchet@sk{0}{1}{0}%
      \belowdisplayshortskip\newchet@sk{4}{2}{2}\belowdisplayskip\abovedisplayskip
      \newchet@listi{4}{2}{2}{2}{1}{1}}
    \newchet@defsize\scriptsize{8}{9.5}{}
    \newchet@defsize\tiny{6}{7}{}
    \newchet@defsize\large{12}{14}{}
    \newchet@defsize\Large{14.4}{18}{}
    \newchet@defsize\LARGE{17.28}{22}{}
    \newchet@defsize\huge{20.74}{25}{}
    \newchet@defsize\Huge{24.88}{30}{}
    \edef\@listI{\leftmargin\leftmargini
      \parsep\newchet@sk{4.5}{2}{1}\topsep\newchet@sk{9}{3}{5}\itemsep\newchet@sk{4.5}{2}{1}}
    \let\@listi\@listI
    \@listi
    \setlength\topskip{\newchet@sc{10.95}\p@}
    \if@twocolumn\else\setlength\parindent{\newchet@sc{17}\p@}\fi
    \setlength\footnotesep{\newchet@sc{7.7}\p@}
    \setlength{\skip\footins}{\newchet@sk{10}{4}{2}}
    % \normalfont first, or the class's font is loaded at the new size
    \normalfont\normalsize
  \else
    \PackageWarningNoLine{newchet}{fontsize only works with article, report and book,%
      \MessageBreak so it is ignored; KOMA classes have their own fontsize option}%
  \fi
\fi
% Word and line spacing, as in chet.sty, so the text is less crammed: interword spaces 1.2
% times wider, lines spread by 1.25 with Computer Modern and by 1.15 with STIX Two and
% newtx, and 5pt instead of 3pt between the rows of multiline equations.  chet.sty widens
% the spaces of the body font alone.  Here every roman font of the text families is widened
% when it is first selected, in every size, series and shape, so italics, bold, footnotes
% and the bibliography match the body.  \fontdimen assignments are global, so a marker for
% each font stops it being widened twice.  Typewriter and sans serif keep their spacing.
% A \linespread or \jot set in the document overrides the values here.
\def\newchet@tempa{cm}
\ifx\newchet@fonts\newchet@tempa
  \def\newchet@widefamilies{cmr}
  \linespread{1.25}
\else
  \def\newchet@tempa{stix2}
  \ifx\newchet@fonts\newchet@tempa
    \def\newchet@widefamilies{stix2}
  \else
    % newtxtext has a roman family for each figure style, e.g. ntxtlf for tabular lining
    % figures, and an ntxth- version of each for its theoremfont option
    \def\newchet@widefamilies{ntxlf,ntxtlf,ntxosf,ntxtosf,ntxth-lf,ntxth-tlf,ntxth-osf,ntxth-tosf}
  \fi
  \linespread{1.15}
\fi
\@for\newchet@tempa:=\newchet@widefamilies\do{%
  \expandafter\let\csname newchet@widefamily@\newchet@tempa\endcsname\@empty}
\def\newchet@widenspace{%
  \ifcsname newchet@widefamily@\f@family\endcsname
    \expandafter\ifx\csname newchet@wide@\fontname\font\endcsname\relax
      \fontdimen2\font=1.2\fontdimen2\font
      \expandafter\gdef\csname newchet@wide@\fontname\font\endcsname{}%
    \fi
  \fi}
\AddToHook{selectfont}{\newchet@widenspace}
% The current font was selected before the hook existed
\newchet@widenspace
\setlength{\jot}{5pt}
\RequirePackage{microtype}
\RequirePackage{booktabs}
\RequirePackage{enumitem}
\RequirePackage{array}
\RequirePackage{float}
\RequirePackage{xcolor}
\RequirePackage[font=small,format=hang,labelfont={sf,bf}]{caption}
\ifnewchet@toc
  \RequirePackage{tocloft}
\fi
% titlesec must come before hyperref, which patches the sectioning commands
\ifnewchet@titlesec
  \RequirePackage{titlesec}
\fi
% manyfoot provides the extra footnote levels for the emails on the title page
\ifnewchet@titlepage
  \RequirePackage[para]{manyfoot}
\fi

\definecolor{forestgreen}{rgb}{0.0,0.27,0.13}
\definecolor{darkblue}{rgb}{0.0,0.0,0.55}
\definecolor{darkred}{rgb}{0.55,0.0,0.0}

\ifnewchet@hyperref
  % pdfusetitle takes pdftitle and pdfauthor from \title and \author; it is
  % only honoured as a load-time option, hence \PassOptionsToPackage here
  \PassOptionsToPackage{pdfusetitle}{hyperref}
  \RequirePackage{hyperref}
  \hypersetup{colorlinks,linkcolor=forestgreen,citecolor=darkblue,
    urlcolor=darkred,linktoc=page,pdfdisplaydoctitle}
\fi

\ifnewchet@theorems
  \newtheorem{theorem}{Theorem}
  \newtheorem{proposition}{Proposition}
  \newtheorem{conjecture}{Conjecture}
\fi

% Table of contents formatting
\ifnewchet@toc
  \setcounter{tocdepth}{3}
  % \hfill + \hspace*{\fill} centres the title exactly as \centerline{\contentsname}
  % did, without putting \centerline inside \contentsname, which breaks in classes
  % that typeset the title in a group (amsart)
  \renewcommand{\cfttoctitlefont}{\hfill\bfseries}
  \renewcommand{\cftaftertoctitle}{\hspace*{\fill}}
  \renewcommand{\cftsecaftersnum}{.}
  \renewcommand{\cftsubsecaftersnum}{.}
  \renewcommand{\cftsubsubsecaftersnum}{.}
  % Narrower number boxes than tocloft's 2.3em and 3.2em, so the gap after the number
  % is about as tight as in the headings.  Each indent is the one above it plus its
  % number box, so the titles of one level stay aligned under each other.
  \setlength{\cftsubsecnumwidth}{2.0em}
  \setlength{\cftsubsubsecindent}{3.5em}
  \setlength{\cftsubsubsecnumwidth}{2.8em}
  % A number too long for its box (10. or 3.10.) would run into the title, so widen
  % the box for that entry to the number plus the same 0.5em gap as in the headings.
  % tocloft calls this hook with the number just before it sets the box to \@tempdima.
  % tocloft before v3.0 (August 2026) has no such hook, so add it to \numberline.
  \@ifundefined{@cftinitnumwidth}{%
    \newcommand{\@cftinitnumwidth}[1]{}%
    \let\newchet@numberline\numberline
    \renewcommand{\numberline}[1]{\@cftinitnumwidth{#1}\newchet@numberline{#1}}}{}
  \renewcommand{\@cftinitnumwidth}[1]{%
    \settowidth{\@tempdimb}{\@cftbsnum #1\@cftasnum\hspace{0.5em}}%
    \ifdim\@tempdimb>\@tempdima \@tempdima\@tempdimb \fi}
  \newcommand{\toc}{\tableofcontents}
\fi

% Section headings: a dot after the number, and two steps smaller than the article
% defaults (\Large and \large).  The sizes are relative, so they follow the class option.
\ifnewchet@titlesec
  \titleformat{\section}{\normalfont\large\bfseries}{\thesection.}{0.5em}{}
  \titleformat{\subsection}{\normalfont\normalsize\bfseries}{\thesubsection.}{0.5em}{}
  \titleformat{\subsubsection}{\normalfont\normalsize\itshape}{\thesubsubsection.}{0.5em}{}
  % Appendices are headed "Appendix A.", as in chet.sty, in the heading and in the table
  % of contents.  Classes with chapters already label their appendix chapters this way.
  \providecommand*{\appendixname}{Appendix}
  \@ifundefined{chapter}{%
    \g@addto@macro\appendix{%
      \titleformat{\section}{\normalfont\large\bfseries}{\appendixname~\thesection.}{0.5em}{}%
      \ifnewchet@toc
        \addtocontents{toc}{\protect\renewcommand{\protect\cftsecpresnum}{\protect\appendixname~}}%
      \fi}}{}
\fi

% ----------------------------------------------------------------------------
% Title page, as in chet.sty
% ----------------------------------------------------------------------------
\ifnewchet@titlepage
% Title font: the 10pt design of Computer Modern scaled up.  Its strokes are heavier
% than those of the large design sizes, which gives the dark harvmac-like title.
% chet.sty maps cmr10 into T1, which has the wrong glyph layout; ecrm1000 is the T1
% version of the same design.  With newtx or stix2 the title is in the text roman instead.
\def\newchet@tempa{cm}
\ifx\newchet@fonts\newchet@tempa
  \DeclareFontFamily{T1}{newchettitle}{}
  \DeclareFontShape{T1}{newchettitle}{m}{n}{<->ecrm1000}{}
  \def\newchet@titlefamily{newchettitle}
\else
  \def\newchet@titlefamily{\rmdefault}
\fi
\newcommand*{\newchettitlefont}{\fontencoding{T1}\fontfamily{\newchet@titlefamily}\fontseries{m}\fontshape{n}\selectfont}
% Math in the title: $\titlemath{...}$
\DeclareMathAlphabet{\titlemath}{T1}{\newchet@titlefamily}{m}{n}
% Title size: 1.894 times the body size, the ratio of \huge to \normalsize at 11pt
% (20.74pt).  \huge itself jumps to 24.88pt at 12pt, which makes the title too large.
\newcommand*{\newchet@titlesize}{%
  \normalsize
  \@tempdima=1.894\dimexpr\f@size pt\relax
  % \fontsize uses \@tempdimb itself, so expand both values before calling it
  \edef\newchet@tempa{{\the\@tempdima}{\the\dimexpr1.205\@tempdima\relax}}%
  \expandafter\fontsize\newchet@tempa\selectfont}

\newcommand*{\preprint}[1]{\gdef\newchet@preprint{#1}}
\newcommand*{\affiliation}[1]{\gdef\newchet@affiliation{#1}}
\preprint{}
\affiliation{}
\gdef\newchet@abstract{}

% \abstract{...} in the preamble stores the abstract for the title page.  In the
% document body the class's abstract environment is restored, so \begin{abstract}
% still works there.
\let\newchet@abstractenv\abstract
\renewcommand{\abstract}[1]{\gdef\newchet@abstract{#1}}
\AtBeginDocument{\let\abstract\newchet@abstractenv}

% Default date: month and year, without changing \today
\date{\ifcase\month\or January\or February\or March\or April\or May\or June\or July\or
  August\or September\or October\or November\or December\fi\space\number\year}

% Emails as footnotes on the title page
\providecommand*{\newchet@mailto}[1]{%
  \@ifundefined{href}{\texttt{#1}}{\href{mailto:#1}{\texttt{#1}}}}
% Side by side
\SetFootnoteHook{\noindent\hspace{-5pt}}
\DeclareNewFootnote[para]{E}[roman]
\newcommand*{\email}[1]{\footnoteE{\newchet@mailto{#1}}}
% One below the other
\SetFootnoteHook{\noindent\hspace{-10pt}}
\DeclareNewFootnote{EE}[roman]
\newcommand*{\emailV}[1]{\footnoteEE{\newchet@mailto{#1}}}
% All together in one footnote without marks
\SetFootnoteHook{\noindent}
\DeclareNewFootnote[para]{EEE}[roman]
\newcommand*{\emails}[1]{\footnotetextEEE{\texttt{#1}}}

% Keep the emails and title commands out of the PDF metadata set by pdfusetitle
\ifnewchet@hyperref
  \pdfstringdefDisableCommands{%
    \def\email#1{}\def\emailV#1{}\def\emails#1{}\def\thanks#1{}%
    \def\titlemath#1{#1}\def\and{, }}
\fi

\renewcommand{\maketitle}{%
  \begin{titlepage}
    \let\footnote\thanks
    \def\and{\unskip\space and\space\ignorespaces}%
    \renewcommand{\thefootnote}{\fnsymbol{footnote}}%
    \begin{flushright}
      \newchet@preprint
    \end{flushright}
    \vspace{2cm}
    \begin{center}
      {\newchet@titlesize\newchettitlefont\@title\par}
      \bigskip\bigskip\bigskip
      \@author\par
      \bigskip
      {\itshape\newchet@affiliation\par}
    \end{center}
    \bigskip\bigskip
    \noindent\newchet@abstract\par
    \vfill
    \noindent\@date
    \@thanks
  \end{titlepage}%
  \setcounter{footnote}{0}%
  \global\let\thanks\relax
  \global\let\@thanks\@empty
  \global\let\maketitle\relax}
\fi

% Figure name
\renewcommand{\figurename}{Fig.}

% Equations numbered within sections
\@ifundefined{c@section}{}{\numberwithin{equation}{section}}

% For bold math in section headings
\g@addto@macro\bfseries{\boldmath}
% amsthm's \@thm forces \thm@notefont{\fontseries\mddefault\upshape} for every theorem, so the bracketed note is set in medium weight while the head punctuation that follows it reverts to the (bold) head font.  Match the note to the head instead.  \bfseries carries \boldmath by the hack above, so math in a theorem note is set in bold math, as intended.  The same applies to the "definition" style, whose head is also bold.  The "remark" style has an italic head and a medium note, which already match, so it is left alone.
\g@addto@macro\th@plain{\thm@notefont{\bfseries}}
\g@addto@macro\th@definition{\thm@notefont{\bfseries}}

\allowdisplaybreaks

\setlist{itemsep=1pt,topsep=3pt}

% Acknowledgements, as in chet.sty: a bold centred heading, then the text.
% Both spellings of the environment work.  Classes that define their own (revtex
% has acknowledgments) keep theirs.  \ack{...} is a shortcut for the environment.
\providecommand*{\acknowledgementsname}{Acknowledgements}
\@ifundefined{acknowledgements}{%
  \newenvironment{acknowledgements}
    {\par\vspace{12pt}{\centering\textbf{\acknowledgementsname}\par}\nobreak\noindent\ignorespaces}
    {\par}}{}
\@ifundefined{acknowledgments}{%
  \newenvironment{acknowledgments}{\acknowledgements}{\endacknowledgements}}{}
\providecommand{\ack}[1]{\begin{acknowledgements}#1\end{acknowledgements}}

% ----------------------------------------------------------------------------
% Bibliography: the former chetref.bbx and chetref.cbx, applied inline
%
% chetref imitates chetref.bst (v2.3a).  Entries read as
%   J. Smith, B. Jones & D. Brown, ``Title'', Journal vol, page (year), arXiv:XXXX.XXXXX [class].
% with the title in italics, the journal reference linked to the DOI and the arXiv identifier in
% typewriter type linked to arxiv.org.  As in chetref.bst, a two-digit JHEP volume is printed with
% the year prepended (JHEP 2104 for volume 04 of 2021), every eprint is taken to be an arXiv
% identifier, and the bibliography is in citation order.  Unlike chetref.bst, all given-name
% initials are printed.  Citations are sorted and compressed, as with the cite package.
%
% Also as in chetref.bst: a collaboration field prints "ATLAS Collaboration" before the
% authors, a JHEP article without a doi gets one inferred from volume, year and page, and
% the members of a group of references start on new lines.  Groups need the mcite option,
% \usepackage[mcite]{newchet}, and biblatex's syntax, whose first key names the group:
%   \mcite{group1,*key1,*key2}
% chet's \cite{key1,*key2} would drop key1, since biblatex takes it as the group's name.
% ----------------------------------------------------------------------------
% With nobib, stop reading here rather than skip the rest with \ifnewchet@bib ... \fi.
% Skipping would still count conditionals, and memoir defines \ifinteger with \newif,
% so the \ifinteger below would swallow the closing \fi and the whole document.
\ifnewchet@bib\else
  \expandafter\endinput
\fi
\RequirePackage[backend=biber,style=numeric-comp]{biblatex}

\renewcommand*{\bibfont}{\small}

% The References heading is centred and set at the body size, like the Acknowledgements
% heading, as in chet.sty.  titlesec's default shape ignores
% \centering in the title, so with titlesec the heading gets a centred format of its own.
% The space below it is cut, as chet.sty does with \vspace{-0.4cm}, so the first entry sits
% about 18.5pt below the heading's baseline at 12pt, as in chet.sty.
\defbibheading{bibliography}[\refname]{%
  \ifnewchet@titlesec
    {\titleformat{name=\section,numberless}[block]{\normalfont\normalsize\bfseries\filcenter}{}{0pt}{}%
     \titlespacing*{\section}{0pt}{3.5ex plus 1ex minus .2ex}{0.8ex plus .2ex}%
     \section*{#1}}%
  \else
    \section*{\centering\normalsize #1}\vspace{-7pt}%
  \fi
  \markboth{\MakeUppercase{#1}}{\MakeUppercase{#1}}}

\ExecuteBibliographyOptions{sorting=none,giveninits=true,maxbibnames=99,minbibnames=99}

% biblatex has no collaboration field, so biber would drop it.  Keep it in usera.
\DeclareSourcemap{
  \maps[datatype=bibtex]{
    \map{\step[fieldsource=collaboration, fieldtarget=usera]}}}

% "Master's thesis" rather than biblatex's "MA thesis"
\DefineBibliographyStrings{english}{mathesis={Master's thesis}}
\DefineBibliographyStrings{british}{mathesis={Master's thesis}}
\DefineBibliographyStrings{american}{mathesis={Master's thesis}}

\providecommand*{\arxivref}[2]{\href{https://arxiv.org/abs/#1}{#2}}
\providecommand*{\doiref}[2]{\href{https://doi.org/#1}{#2}}

% Punctuation: every unit is separated by a comma, and entries end with a period
\renewcommand*{\newunitpunct}{\addcomma\space}
\renewcommand*{\newblockpunct}{\addcomma\space}
\renewcommand*{\finentrypunct}{\addperiod}
% Members of a group of references (\mcite) are separated by a semicolon and a new line
\renewcommand*{\entrysetpunct}{\addsemicolon\newline}

% Names: F.~Last, with commas between names and & before the last one (no serial comma)
\DeclareNameAlias{default}{given-family}
\DeclareNameAlias{author}{given-family}
\DeclareNameAlias{editor}{given-family}
\DeclareDelimFormat{multinamedelim}{\addcomma\space}
\DeclareDelimFormat{finalnamedelim}{\addspace\&\space}
\DeclareDelimFormat{andothersdelim}{\addspace}
% biblatex's name:andothers puts \finalandcomma before "et al." after two or more names,
% and chetref does not.  Redefining \finalandcomma itself would not last, since the
% english language file sets it again at the start of the document.
\renewbibmacro*{name:andothers}{%
  \ifboolexpr{
    test {\ifnumequal{\value{listcount}}{\value{liststop}}}
    and
    test \ifmorenames
  }
    {\printdelim{andothersdelim}\bibstring{andothers}}
    {}}

% Fields
% \isdot keeps a title that ends in a full stop from swallowing the comma after it
\DeclareFieldFormat*{title}{\textit{``#1\isdot''}}
\DeclareFieldFormat{booktitle}{in \textit{``#1\isdot''}}
\DeclareFieldFormat{edition}{\ifinteger{#1}{\mkbibordedition{#1}~edition}{\chetedition{#1}}}
\DeclareFieldFormat{chet:collaboration}{#1~Collaboration}
\DeclareFieldFormat{pages}{p\adddot~#1}
\DeclareFieldFormat{chet:firstpage}{\mkfirstpage{#1}}
\DeclareFieldFormat{chet:doilink}{\iffieldundef{doi}{\chetjhepdoilink{#1}}{\doiref{\thefield{doi}}{#1}}}

\ExplSyntaxOn
% JHEP volume 04 of 2021 is printed as 2104
\cs_new:Npn \chet_jhep_volume:nn #1#2
  {
    \bool_lazy_and:nnTF
      { \int_compare_p:nNn { \str_count:n {#1} } = { 2 } }
      { \int_compare_p:nNn { \str_count:n {#2} } = { 4 } }
      { \str_range:nnn {#2} {3} {4} #1 }
      {#1}
  }
\cs_new:Npn \chetvolume
  {
    \iffieldequalstr { journaltitle } { JHEP }
      { \exp_args:Nee \chet_jhep_volume:nn { \thefield { volume } } { \thefield { year } } }
      { \thefield { volume } }
  }
% A JHEP article without a doi links to the DOI inferred from volume, year and first
% page.  JHEP moved from IOP to Springer in 2009, which changed the DOI pattern:
%   up to 2008   10.1088/1126-6708/1999/05/021
%   from 2009    10.1007/JHEP08(2012)034
% chetref.bst only infers DOIs for years starting 199 or 201.
\tl_new:N \l__chet_volume_tl
\tl_new:N \l__chet_year_tl
\tl_new:N \l__chet_page_tl
\tl_new:N \l__chet_doi_tl
\cs_new_protected:Npn \chet_jhep_doilink:n #1
  {
    \tl_clear:N \l__chet_doi_tl
    \iffieldequalstr { journaltitle } { JHEP }
      {
        \tl_set:Ne \l__chet_volume_tl { \thefield { volume } }
        \tl_set:Ne \l__chet_year_tl { \thefield { year } }
        \iffieldundef { pages } { \tl_clear:N \l__chet_page_tl }
          { \tl_set:Ne \l__chet_page_tl { \thefield { pages } } }
        \bool_lazy_all:nT
          {
            { \int_compare_p:nNn { \tl_count:N \l__chet_volume_tl } = { 2 } }
            { \int_compare_p:nNn { \tl_count:N \l__chet_year_tl } = { 4 } }
            { ! \tl_if_empty_p:N \l__chet_page_tl }
          }
          {
            \int_compare:nNnTF { \l__chet_year_tl } < { 2009 }
              {
                \tl_set:Ne \l__chet_doi_tl
                  { 10.1088/1126-6708/ \l__chet_year_tl / \l__chet_volume_tl / \l__chet_page_tl }
              }
              {
                \tl_set:Ne \l__chet_doi_tl
                  { 10.1007/JHEP \l__chet_volume_tl ( \l__chet_year_tl ) \l__chet_page_tl }
              }
          }
      }
      { }
    \tl_if_empty:NTF \l__chet_doi_tl
      {#1}
      { \exp_args:NV \doiref \l__chet_doi_tl {#1} }
  }
\cs_new_eq:NN \chetjhepdoilink \chet_jhep_doilink:n
% A non-numeric edition gets "edition" appended, unless it already says so
\cs_new_protected:Npn \chet_print_edition:n #1
  { \tl_if_in:nnTF {#1} { edition } {#1} { #1 \nobreakspace edition } }
\cs_new_eq:NN \chetedition \chet_print_edition:n
% An eprint without a scheme (e.g. hep-th/9711200) gets no arXiv: prefix.  An eprint
% that already starts with arXiv: has it removed first, so it is not printed twice.
\cs_new_protected:Npn \chet_print_eprint:n #1
  {
    \tl_set:Ne \l_tmpa_tl {#1}
    \str_if_eq:eeT
      { \str_lowercase:f { \str_range:Nnn \l_tmpa_tl { 1 } { 6 } } }
      { arxiv: }
      { \tl_set:Ne \l_tmpa_tl { \str_range:Nnn \l_tmpa_tl { 7 } { -1 } } }
    \tl_if_in:NnTF \l_tmpa_tl { / }
      { \tl_set_eq:NN \l_tmpb_tl \l_tmpa_tl }
      { \tl_set:Ne \l_tmpb_tl { arXiv: \l_tmpa_tl } }
    \texttt
      {
        \exp_args:NV \arxivref \l_tmpa_tl
          {
            \l_tmpb_tl
            \iffieldundef { eprintclass } { } { \space\![\thefield{eprintclass}] }
          }
      }
  }
\cs_new_eq:NN \chetprinteprint \chet_print_eprint:n
\ExplSyntaxOff

\DeclareFieldFormat{eprint}{\chetprinteprint{#1}}
\DeclareFieldFormat{url}{\url{#1}}

% Building blocks
\newbibmacro*{chet:authors}{%
